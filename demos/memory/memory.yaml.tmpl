apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-memory-gradient

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: memory-gradient
  namespace: ate-demo-memory-gradient
  labels:
    workload: memory-gradient
spec:
  replicas: 8
  ateomImage: ${ATEOM_IMAGE}

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: memory-64m
  namespace: ate-demo-memory-gradient
spec:
  pauseImage: "registry.k8s.io/pause:3.10.2@sha256:f548e0e8e3dc1896ca956272154dde3314e8cc4fde0a57577ee9fa1c63f5baf4"
  containers:
  - name: memory
    image: ${MEMORY_IMAGE}
    command: ["/ko-app/memory"]
    env:
    - name: TARGET_MEMORY_MIB
      value: "64"
    - name: MEMORY_PATTERN
      value: "${MEMORY_PATTERN}"
    - name: MEMORY_SEED
      value: "${MEMORY_SEED}"
    readyz:
      httpGet:
        path: /readyz
        port: 80
  workerSelector:
    matchLabels:
      workload: memory-gradient
  snapshotsConfig:
    onPause: Full
    onCommit: Full
    location: ${SNAPSHOT_LOCATION}/memory-64m/

